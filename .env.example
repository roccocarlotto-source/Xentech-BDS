# Base de datos (Postgres, vía Supabase — pooler para runtime, conexión directa para migraciones)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth (verificación de JWT vía JWKS)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# Server
PORT=3000
NODE_ENV=development

# Fase 5 -- agentes de IA. Requerido solo para mandarle un mensaje a un
# agente (endpoint de prueba o WhatsApp real); el resto del server arranca
# sin esto. Ver src/lib/llm/provider.ts y docs/ai-agent-architecture.md.
# OPENROUTER_API_KEY="<api key de openrouter.ai>"

# Solo para scripts/e2e-smoke.ts (workflow manual e2e-smoke.yml) -- el
# server de la app nunca los usa. SUPABASE_SERVICE_ROLE_KEY bypassea
# permisos: no lo pongas en ningún .env que corra fuera de ese workflow.
# SUPABASE_SERVICE_ROLE_KEY="<service_role key del proyecto>"
# SUPABASE_ANON_KEY="<anon key del proyecto>"
