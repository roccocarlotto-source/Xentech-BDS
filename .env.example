# Base de datos (Postgres, vía Supabase — pooler para runtime, conexión directa para migraciones)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth (verificación de JWT vía JWKS)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# Server
PORT=3000
NODE_ENV=development

# CORS -- lista separada por comas de orígenes permitidos. Sin configurar,
# el default es el puerto de Vite en desarrollo (http://localhost:5173) --
# ver src/lib/corsOrigins.ts. Configurar en producción con el/los dominios
# reales del frontend.
# CORS_ORIGINS="https://app.xentech.com"

# Rate limiting genérico de la API (por IP) -- ver src/lib/rateLimitConfig.ts.
# Defaults: 600 requests cada 15 minutos.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=600

# Fase 5 -- agentes de IA. Requerido solo para mandarle un mensaje a un
# agente (endpoint de prueba o WhatsApp real); el resto del server arranca
# sin esto. Ver src/lib/llm/provider.ts y docs/ai-agent-architecture.md.
# OPENROUTER_API_KEY="<api key de openrouter.ai>"

# Fase 5, paso 5 -- conexión real de WhatsApp (docs/ai-agent-architecture.md
# §4). Todavía no hay conexión real armada (falta el trámite de Meta
# Business), pero estas ya hacen falta para el webhook y la encriptación
# del token de WhatsAppConnection:
# WHATSAPP_WEBHOOK_VERIFY_TOKEN="<elegís vos un string cualquiera, se lo pasás a Meta al configurar el webhook>"
# WHATSAPP_APP_SECRET="<App Secret de la app de Meta, para validar la firma de cada request>"
# WHATSAPP_TOKEN_ENCRYPTION_KEY="<32 bytes en base64 -- generar con: openssl rand -base64 32>"

# Etapa 5, paso 2 de docs/seguimiento-resenas-diseno.md -- motor de envío de
# email. Proveedor elegido el 2026-09-26: Resend. Hacen falta LAS DOS
# primeras para que el motor mande algo: getEmailProvider() en
# src/lib/email/emailProvider.ts devuelve `null` si falta alguna, y el job
# queda encendido pero inactivo (no gasta intentos de ningún `Envio`).
# El dominio de EMAIL_FROM tiene que estar verificado en Resend, si no todos
# los envíos vuelven 403 -- depende de la decisión de dominio, todavía
# abierta (ver docs/deployment.md).
# RESEND_API_KEY="<api key de resend.com, empieza con re_>"
# EMAIL_FROM="Imagen Visual <presupuestos@tudominio.com>"
# A dónde llegan las respuestas del cliente (§5 le pide responder "BAJA").
# Es la dirección BASE: cada email sale con un Reply-To
# "respuestas+<id del presupuesto>@..." para poder saber de qué presupuesto
# es cada respuesta (ver src/lib/email/direccionRespuesta.ts). Sin esto las
# respuestas van a EMAIL_FROM y el webhook las ubica por el email del
# cliente, que es menos preciso.
# EMAIL_REPLY_TO="respuestas@tudominio.com"

# Etapa 5, recepción de respuestas (§6.4). Resend manda un POST a
# /api/webhooks/email cuando llega un mail; este secret verifica la firma
# (esquema Svix). Sale de la página del webhook en el panel de Resend.
# Para recibir hace falta un MX: puede ser el subdominio <id>.resend.app que
# da Resend, sin dominio propio -- útil para probar antes de decidir dominio.
# RESEND_WEBHOOK_SECRET="whsec_..."

# Etapa 4 de docs/seguimiento-resenas-diseno.md -- extracción de datos de
# presupuestos (.docx) por IA. Usa OPENROUTER_API_KEY (arriba). Sin
# configurar, usa un default fijo en presupuestoImport.service.ts.
# PRESUPUESTO_EXTRACTION_MODEL="anthropic/claude-3.5-haiku"

# Etapa 7 -- clasificación de las respuestas de los clientes (§6.5). Usa
# OPENROUTER_API_KEY (arriba). Sin configurar, usa el mismo default que la
# extracción.
# CLASIFICACION_MODEL="anthropic/claude-3.5-haiku"

# Solo para scripts/e2e-smoke.ts (workflow manual e2e-smoke.yml) -- el
# server de la app nunca los usa. SUPABASE_SERVICE_ROLE_KEY bypassea
# permisos: no lo pongas en ningún .env que corra fuera de ese workflow.
# SUPABASE_SERVICE_ROLE_KEY="<service_role key del proyecto>"
# SUPABASE_ANON_KEY="<anon key del proyecto>"

# URL pública del frontend, para armar links absolutos en los emails (por
# ejemplo el link de reseña que se manda al cliente). Sin esto, el link se
# genera igual pero hay que copiarlo a mano desde el panel -- no se puede
# mandar por email. Se completa cuando haya dominio y despliegue.
# APP_PUBLIC_URL="https://resenas.tudominio.com"
