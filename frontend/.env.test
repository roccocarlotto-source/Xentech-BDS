# Vite carga este archivo automáticamente en modo "test" (vitest usa ese
# modo por defecto) — valores dummy para que cualquier test que importe
# transitivamente src/lib/supabase.ts (y por lo tanto src/config/env.ts, que
# valida estas variables al cargarse el módulo) no explote solo por no tener
# credenciales reales. Nunca se usa para conectar a nada real.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=test-anon-key
VITE_API_URL=http://localhost:3000
